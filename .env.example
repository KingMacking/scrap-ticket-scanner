# Variables de entorno — desarrollo local (copiar a .env)
# Gemini API key — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key

# Supabase — https://supabase.com/dashboard/project/[project-ref]/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# En producción (Netlify), configurar en Site Settings → Environment Variables:
#   GEMINI_API_KEY                (sin VITE_, solo server-side)
