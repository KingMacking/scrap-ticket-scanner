# Variables de entorno — desarrollo local (copiar a .env)
# Cloudflare Workers AI — https://dash.cloudflare.com/profile/api-tokens
VITE_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# En producción (Netlify), configurar estas mismas vars en:
# Site Settings → Environment Variables (sin prefijo VITE_):
#   CLOUDFLARE_API_TOKEN
#   CLOUDFLARE_ACCOUNT_ID
